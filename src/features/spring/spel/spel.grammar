// Spring Expression Language: the expressions of `#{…}` templates and of the annotation
// attributes that take a bare expression (`@Cacheable(key = …)`, `@EventListener(condition = …)`),
// after Spring's `org.springframework.expression.spel.standard.Tokenizer` and
// `InternalSpelExpressionParser`. Textual operators are recognised in lower and upper case
// (SpEL is case-insensitive there). Regenerate with `pnpm gen:spel-grammar`.

@precedence {
  dims,
  member,
  call,
  postfix,
  prefix @right,
  power @right,
  times @left,
  plus @left,
  rel @left,
  and @left,
  or @left,
  ternary @right,
  assign @right
}

@skip { space } {
  @top Spel { expression? }

  expression[@isGroup=Expression] {
    literal |
    PropertyName |
    VariableName |
    BeanReference |
    TypeReference |
    NewExpression |
    InlineList |
    InlineMap |
    ParenthesizedExpression { "(" expression ")" } |
    MemberExpression { expression !member navigation PropertyName } |
    CollectionExpression { expression !member navigation CollectionOp expression "]" } |
    IndexExpression { expression !member "[" expression "]" } |
    CallExpression { expression !call ArgList } |
    UnaryExpression { (LogicOp<"!"> | op<"not", "NOT"> | ArithOp<"-" | "+" | "++" | "--">) !prefix expression } |
    PostfixExpression { expression !postfix ArithOp<"++" | "--"> } |
    BinaryExpression {
      expression !power ArithOp<"^"> expression |
      expression !times (ArithOp<"*" | "/" | "%"> | op<"div", "DIV"> | op<"mod", "MOD">) expression |
      expression !plus ArithOp<"+" | "-"> expression |
      expression !rel (CompareOp<"==" | "!=" | "<" | ">" | "<=" | ">="> | relWord) expression |
      expression !and (LogicOp<"&&"> | op<"and", "AND">) expression |
      expression !or (LogicOp<"||"> | op<"or", "OR">) expression
    } |
    ConditionalExpression { expression !ternary "?" expression ":" expression } |
    ElvisExpression { expression !ternary "?:" expression } |
    AssignmentExpression { expression !assign "=" expression }
  }

  navigation { "." | "?." }

  BeanReference { BeanName | FactoryBeanName | ("@" | "&") String }

  TypeReference { kw<"T"> "(" QualifiedName ("[" "]")* ")" }

  NewExpression { kw<"new"> QualifiedName (ArgList | Dimension (!dims Dimension)* (!dims InlineList)?) }

  Dimension { "[" expression? "]" }

  QualifiedName { TypeName ("." TypeName)* }

  InlineList { "{" (expression ("," expression)*)? "}" }

  InlineMap { "{" (":" | MapEntry ("," MapEntry)*) "}" }

  MapEntry { expression !ternary ":" expression }

  ArgList { "(" (expression ("," expression)*)? ")" }
}

relWord {
  op<"eq", "EQ"> | op<"ne", "NE"> | op<"lt", "LT"> | op<"gt", "GT"> | op<"le", "LE"> | op<"ge", "GE"> |
  op<"instanceof", "INSTANCEOF"> | op<"matches", "MATCHES"> | op<"between", "BETWEEN">
}

literal {
  Number |
  String |
  @specialize[@name=BooleanLiteral]<identifier, "true" | "false" | "TRUE" | "FALSE"> |
  @specialize[@name=null]<identifier, "null" | "NULL">
}

PropertyName { identifier }

TypeName { identifier }

CollectionOp { "![" | "?[" | "^[" | "$[" }

kw<term> { @specialize[@name={term}]<identifier, term> }

op<lower, upper> { @specialize[@name={lower}]<identifier, lower | upper> }

ArithOp<expr> { expr }
CompareOp<expr> { expr }
LogicOp<expr> { expr }

@tokens {
  space { $[ \t\n\r]+ }

  identifier { $[a-zA-Z_$\u{a1}-\u{10ffff}] $[a-zA-Z0-9_$\u{a1}-\u{10ffff}]* }

  // `#root`, `#this`, `#p0`, `#order`, `#fn` of a registered function.
  VariableName { "#" $[a-zA-Z_$] $[a-zA-Z0-9_$]* }

  // `@orderService`, `&factory`: Spring's bean name characters include `.`, `-` and `/`
  // only when quoted.
  BeanName { "@" $[a-zA-Z_$] $[a-zA-Z0-9_$]* }
  FactoryBeanName { "&" $[a-zA-Z_$] $[a-zA-Z0-9_$]* }

  Number {
    "0" $[xX] $[0-9a-fA-F]+ $[lL]? |
    (@digit+ ("." @digit+)? | "." @digit+) ($[eE] $[+\-]? @digit+)? $[lLfFdD]?
  }

  // `'it''s'`, `"say ""hi"""`: a quote is doubled inside.
  String {
    "'" (!['] | "''")* "'"? |
    '"' (!["] | '""')* '"'?
  }

  @precedence { Number, "." }
  @precedence { "?.", "?[", "?:", "?" }
  @precedence { "&&", FactoryBeanName, "&" }
  @precedence { BeanName, "@" }
  @precedence { "$[", identifier }

  "(" ")" "[" "]" "{" "}" "." "?." "," ":" "?" "?:" "=" "@" "&"
  "![" "?[" "^[" "$["
}

@detectDelim
