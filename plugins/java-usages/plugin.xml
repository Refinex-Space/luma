<?xml version="1.0" encoding="UTF-8"?>
<plugin>
  <extension point="org.eclipse.jdt.ls.core.delegateCommandHandler">
    <delegateCommandHandler class="ai.luma.usages.UsagesCommand">
      <command id="luma.java.usages"/>
    </delegateCommandHandler>
    <delegateCommandHandler class="ai.luma.usages.UsageCountsCommand">
      <command id="luma.java.usageCounts"/>
    </delegateCommandHandler>
    <delegateCommandHandler class="ai.luma.configuration.ConfigurationCommand">
      <command id="luma.java.configuration"/>
    </delegateCommandHandler>
    <delegateCommandHandler class="ai.luma.spring.LibraryCommand">
      <command id="luma.spring.library"/>
      <command id="luma.spring.locate"/>
    </delegateCommandHandler>
    <delegateCommandHandler class="ai.luma.spring.EventsCommand">
      <command id="luma.spring.events"/>
    </delegateCommandHandler>
    <delegateCommandHandler class="ai.luma.spring.MembersCommand">
      <command id="luma.spring.members"/>
    </delegateCommandHandler>
  </extension>
</plugin>
